# Copy to .env and adjust. main.js reads these from the environment;
# it does not load .env by itself. Run with:  node --env-file=.env main.js  (Node 20.6+)

# Port for the HTTP API (default 3001)
HTTP_PORT=3001

# Port for the WebSocket peer-to-peer server (default 6001)
P2P_PORT=6001

# Comma-separated peers to connect to on startup (default: none)
# PEERS=ws://localhost:6001,ws://localhost:6002
